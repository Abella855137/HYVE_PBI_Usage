table 'RLS Data'
	lineageTag: b931d928-24df-463a-aa45-48b0f7f7c001

	measure '~Flag RLS Users' = CALCULATE(DISTINCTCOUNT('RLS Data'[#User Name]),'RLS Data'[~Has SPY] = "N")
		formatString: 0
		lineageTag: 3193cba8-874a-4c35-bd90-aeec17eadd82

	measure '~Flag RLS Users Ratio' = DIVIDE([~Flag RLS Users], COUNT('RLS Data'[#User Name]))
		lineageTag: a053de73-7efe-42e6-b9f0-2f8da95fb771

		annotation PBI_FormatHint = {"isGeneralNumber":true}

