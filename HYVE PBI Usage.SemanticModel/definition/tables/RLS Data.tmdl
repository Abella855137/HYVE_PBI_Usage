	column '~Has SPY' = ```
			
			IF(
			    CONTAINS(
			        'PBI Spy User Access',
			        'PBI Spy User Access'[global_employee_id],
			        'RLS Data'[Global ID]
			    ),
			    "Y", 
			    "N"
			)
			```
		lineageTag: 9a642326-a530-4bb2-9089-95facc1d0ca6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column '#User Name' =
			
			VAR G_ID = LOOKUPVALUE('Employee Info'[Name],'Employee Info'[Employee Global ID],'RLS Data'[Global ID])
			VAR E_ID = LOOKUPVALUE('Employee Info'[Name],'Employee Info'[userPrincipalName],'RLS Data'[Email Address])
			RETURN
			IF(G_ID <> BLANK(), G_ID, E_ID)
		lineageTag: 8c32f5f2-efe1-4a7c-9ce1-5d61c9b31d6b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

