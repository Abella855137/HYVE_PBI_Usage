table 'Usage Log'
	lineageTag: c9c9ad04-022c-4c95-a33f-5d8e468656ac

	/// Total number of usage records in the current filter context.
	measure '~Total Operation' = COUNTROWS('Usage Log')
		formatString: 0
		lineageTag: 464a036c-d93e-4794-8dae-dd0f562b380e

	/// Running total of all operations from the earliest date through the current date in the selected time context.
	measure '~Accumulative Operation' = CALCULATE([~Total Operation],FILTER(ALL('Date'),'Date'[Date]<=MAX('Date'[Date])))
		formatString: 0
		lineageTag: 3a7767fe-4e2c-4f83-b340-743867f113b5

	/// Total number of usage events classified as downloads.
	measure '~Download Count' = CALCULATE(COUNTROWS('Usage Log'),'Usage Log'[#Operation Group] = "Download")
		formatString: 0
		lineageTag: 4d3b14d9-0cbf-4b13-b978-dad9e7a5decf

	/// Total number of usage events classified as views.
	measure '~View Count' = CALCULATE(COUNTROWS('Usage Log'),'Usage Log'[#Operation Group] = "View")
		formatString: 0
		lineageTag: d2624975-4a09-437b-b018-0a9440527bb1

	/// Total number of usage events classified as prints.
	measure '~Print Count' = CALCULATE(COUNTROWS('Usage Log'),'Usage Log'[#Operation Group] = "Print")
		formatString: 0
		lineageTag: 30db9dff-7a1e-4b8c-8962-89a465e7d7e7

	/// Total number of usage events classified as shares.
	measure '~Share Count' = CALCULATE(COUNTROWS('Usage Log'),'Usage Log'[#Operation Group] = "Share")
		formatString: 0
		lineageTag: 434052d1-cc5d-4eb7-ab33-af84b1a600e5

	/// Total number of usage events classified as exports.
	measure '~Export Count' = CALCULATE(COUNTROWS('Usage Log'),'Usage Log'[#Operation Group] = "Export")
		formatString: 0
		lineageTag: a8f65851-831a-4dba-9f28-ef20aae4daf6

	/// Number of days from the first recorded usage to the latest recorded usage, inclusive.
	measure '~Deployed Days' = DATEDIFF(MIN('Usage Log'[create_datetime]),MAX('Usage Log'[create_datetime]),DAY)+1
		formatString: 0
		lineageTag: a2ab59dd-3e99-4bec-9592-d8cbf8ace986

	/// Average number of usage operations per day across the selected date range.
	measure ~View/Day = DIVIDE([~Total Operation],[~Deployed Days])
		lineageTag: 3c9de581-9439-4b23-bc72-b963ffc96661

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Number of distinct months in which a user has activity.
	measure ~ActiveMonths = ```
			
			    CALCULATE(
			        DISTINCTCOUNT('Usage Log'[#Operation Month]),  // 唯一有效月份数
			        ALLEXCEPT('Usage Log', 'Usage Log'[#User Name])  // 按用户分组
			    )
			```
		formatString: 0
		lineageTag: c7841e94-ef65-44db-8368-0c79fb8d561a

	/// Indicator showing whether the current user is in the core development list.
	measure ~CF = ```
			
			VAR IsDevList = {"Wendy Wang", "Matt Xie", "Abella Xu"} 
			VAR IsDev = NOT ISEMPTY( 
			    FILTER( 
			        VALUES('Usage Log'[#User Name]),
			        'Usage Log'[#User Name] IN IsDevList
			    )
			)
			VAR Result = IF(IsDev, 1, 0)
			RETURN Result
			```
		formatString: 0
		lineageTag: d9768186-9527-4f22-a62b-2ab8672a2a23

	/// Placeholder measure for custom report logic or manual use.
	measure Measure
		lineageTag: b1e87a82-574d-4cfe-a492-a5493d7d2e7d

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	/// Total number of calendar months between a user's first and last recorded activity.
	measure ~Duration =
			
			VAR First_Login = CALCULATE(MIN('Usage Log'[create_datetime]), ALLEXCEPT('Usage Log','Usage Log'[#User Name], 'Usage Log'[user_email]))
			VAR Last_Login = CALCULATE(MAX('Usage Log'[create_datetime]), ALLEXCEPT('Usage Log', 'Usage Log'[#User Name], 'Usage Log'[user_email]))
			VAR Result = DATEDIFF(First_Login, Last_Login, MONTH)
			RETURN Result
		formatString: 0
		lineageTag: 75a7c923-1bc2-4f97-a534-9e2bd1d98ed5

