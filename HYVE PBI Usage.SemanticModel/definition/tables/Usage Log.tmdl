	/// Date value extracted from the creation timestamp for time-based analysis.
	column #Date = 'Usage Log'[create_datetime].[Date]
		formatString: General Date
		lineageTag: cb12bf03-8280-49ce-a2f6-e5d7f0339649
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Normalized environment source: Cloud or CIS based on the env_type field.
	column #Source = IF('Usage Log'[env_type] = "MS Cloud","Cloud","CIS")
		lineageTag: a3446c9f-3f0c-4c9c-8ebf-e44359d9be82
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Resolved employee name for each usage row, using the employee lookup and fallback rules.
	column '#User Name' = ```
			
			VAR CIS_GID = LOOKUPVALUE('Employee Info'[Name],'Employee Info'[Employee Global ID],'Usage Log'[globalid])
			VAR C_NOW = LOOKUPVALUE('Employee Info'[Name],'Employee Info'[userPrincipalName],'Usage Log'[user_email])
			VAR C_TD = LOOKUPVALUE('Employee Info'[Name],'Employee Info'[tdsnx_upn],'Usage Log'[user_email])
			VAR C_LTD = LOOKUPVALUE('Employee Info'[Name],'Employee Info'[ltd_upn],'Usage Log'[user_email])
			VAR RESULT = 
			IF('Usage Log'[env_type] = "SYNNEX CENTRAL",IF(CIS_GID <> BLANK(), CIS_GID, "Others"),
			SWITCH(
			    TRUE(),
			    C_NOW <> BLANK(), C_NOW,
			    C_TD  <> BLANK(), C_TD,
			    C_LTD <> BLANK(), C_LTD,
			    "Others"
			))
			RETURN RESULT
			```
		lineageTag: cdde2875-0aec-4cd0-8900-8712825f516c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Grouped action type such as Download, View, Print, Share, Export, or Other Operations.
	column '#Operation Group' =
			
			IF(SEARCH("*Download*",'Usage Log'[Operation],1,0),"Download",
			IF(SEARCH("*View*",'Usage Log'[Operation],1,0),"View",
			IF(SEARCH("*Print*",'Usage Log'[Operation],1,0),"Print",
			IF(SEARCH("*Share*",'Usage Log'[Operation],1,0),"Share",
			IF(SEARCH("*Export*",'Usage Log'[Operation],1,0),"Export","Other Operations")))))
		lineageTag: 7e350321-8d98-4c42-b411-6dd22e3bda2a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Month label in YYYY-MM format for monthly aggregation.
	column '#Operation Month' = FORMAT('Usage Log'[create_datetime], "YYYY-MM")
		lineageTag: b153e820-3cf0-4e95-a45e-8f338bfe20d5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Flag indicating when a usage record could not be matched to a valid employee name.
	column '#Account/Name Mapping Failed' = IF('Usage Log'[#User Name] = "Others", IF('Usage Log'[globalid] <> BLANK(), "Resigned", "UPN changed and no matching"))
		lineageTag: 1de6f982-ab30-4647-8201-01507072404b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Number of calendar months between each user's first and most recent activity.
	column #Duration =
			
			VAR First_Login = CALCULATE(MIN('Usage Log'[create_datetime]), ALLEXCEPT('Usage Log','Usage Log'[#User Name], 'Usage Log'[user_email]))
			VAR Last_Login = CALCULATE(MAX('Usage Log'[create_datetime]), ALLEXCEPT('Usage Log', 'Usage Log'[#User Name], 'Usage Log'[user_email]))
			VAR Result = DATEDIFF(First_Login, Last_Login, MONTH)
			RETURN Result
		formatString: 0
		lineageTag: 21fc96ae-8c19-4f37-808b-d34371ea1844
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// Time-in-system bucket based on each user's duration of activity.
	column '#Duration Group' =
			
			SWITCH(
			    TRUE(),
			    [#Duration] <= 3, "1-3 Months",
			    [#Duration] <= 6, "4-6 Months",
			    [#Duration] <= 12, "7-12 Months",
			    [#Duration] > 12, "Over 12 Months"
			    )
		lineageTag: 453a3667-cd23-4e53-bcc9-edc1dcbf00c1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Recency bucket showing how recently each user has been active.
	column '#Recency Group' =
			
			SWITCH(
			    TRUE(),
			    [#Recency] <= 30, "0-30 Days",
			    [#Recency] <= 60, "31-60 Days",
			    [#Recency] <= 90, "61-90 Days",
			    "90+ Days")
		lineageTag: 07585a6e-ac01-439b-a013-12aa2bfde4c7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Number of days since each user's most recent activity.
	column #Recency =
			
			VAR Last_Login = CALCULATE(MAX('Usage Log'[create_datetime]), ALLEXCEPT('Usage Log', 'Usage Log'[#User Name], 'Usage Log'[user_email]))
			VAR Result = DATEDIFF(Last_Login,MAX('Usage Log'[create_datetime]), DAY)
			RETURN Result
		dataType: int64
		formatString: 0
		lineageTag: 8f673208-7a67-4b10-a01e-317dd04af7d8
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	/// Number of operations within the last 30 days for each user.
	column '#Operation within 30 days' = ```
			
			CALCULATE(
			    COUNTROWS('Usage Log'), 
			    'Usage Log'[create_datetime] >= MAX('Usage Log'[create_datetime]) - 30,
			    ALLEXCEPT('Usage Log', 'Usage Log'[#User Name], 'Usage Log'[user_email])
			)
			```
		formatString: 0
		lineageTag: 64db27e4-234b-45f7-aaf7-0c2611a4986b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	hierarchy '#User Name Hierarchy'
		lineageTag: 7207efe5-eb88-4417-8f74-3f0410a21c70

		level 'User Name'
			lineageTag: ed4fdf6e-9918-4c25-9082-6d163bceb83d
			column: '#User Name'

		level user_email
			lineageTag: f60156c7-e573-48e9-97c1-5024fc24134f
			column: user_email

	hierarchy '#User Name Hierarchy 2'
		lineageTag: 8cb13131-ca91-4afa-a69f-b07df5f8c3d3

		level '#User Name'
			lineageTag: 2c48169a-80a9-4f69-a51b-a7bc3e47a175
			column: '#User Name'

		level create_datetime
			lineageTag: f49d22d5-2661-4037-951b-2bee2f2d73e0
			column: create_datetime

	partition 'Usage Log' = m
		mode: import
		source =
				let
				    Source = Odbc.Query("dsn=vertica_prod", "Select *#(lf)FROM dw_gbl.dwd_pub_log_pbi_content_access_log#(lf)WHERE workspace_name IN ('Hyve Corp')")
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

