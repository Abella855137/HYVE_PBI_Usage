	column '#User Name Additional' = ```
			
			VAR CIS_GID = LOOKUPVALUE('Employee Info'[Name],'Employee Info'[Employee Global ID],'RLS Combine'[Global ID])
			VAR C_NOW = LOOKUPVALUE('Employee Info'[Name],'Employee Info'[userPrincipalName],'RLS Combine'[UPN])
			VAR C_TD = LOOKUPVALUE('Employee Info'[Name],'Employee Info'[tdsnx_upn],'RLS Combine'[UPN])
			VAR C_LTD = LOOKUPVALUE('Employee Info'[Name],'Employee Info'[ltd_upn],'RLS Combine'[UPN])
			VAR RESULT = 
			IF('RLS Combine'[User Name] = BLANK(),
			SWITCH(
			    TRUE(),
			    CIS_GID <> BLANK(), CIS_GID,
			    C_NOW <> BLANK(), C_NOW,
			    C_TD  <> BLANK(), C_TD,
			    C_LTD <> BLANK(), C_LTD
			), 'RLS Combine'[User Name])
			RETURN RESULT
			```
		lineageTag: 57a25faa-50be-48aa-a76f-5554ae47618f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column '#Has SPY' = ```
			
			IF(
			    CONTAINS(
			        'PBI Spy User Access',
			        'PBI Spy User Access'[SPY UPN],
			        'RLS Combine'[UPN]
			    ) ||
			    CONTAINS(
			        'PBI Spy User Access',
			        'PBI Spy User Access'[global_employee_id],
			        'RLS Combine'[Global ID]
			    ),
			    "Y", 
			    "N"
			)
			```
		lineageTag: 801fe2ed-2b94-4cc1-a74c-bcabc5b14b66
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

