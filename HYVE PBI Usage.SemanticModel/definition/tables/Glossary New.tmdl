table 'Glossary New'
	lineageTag: 9d7f1a8c-6e4b-4a1d-b5c2-3f8a9e7d6c1b

	/// Display name for the column or measure as shown in visuals and UI
	column 'Display Name' = 
			IF(
			    LEFT([Name], 1) = "#" || LEFT([Name], 1) = "~",
			    MID([Name], 2, LEN([Name])),
			    [Name]
			)
		dataType: string
		lineageTag: d4e5f6a7-b8c9-0d1e-2f3a-4b5c6d7e8f9a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Name
		lineageTag: 2539f8a7-2542-4c8b-bc32-96cbc5816a7d
		summarizeBy: none
		isNameInferred
		sourceColumn: [Name]

		annotation SummarizationSetBy = Automatic

	column Table
		lineageTag: 94ce2973-bcbe-497c-962a-5328515cdc9b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Table]

		annotation SummarizationSetBy = Automatic

	column Description
		lineageTag: c4e4a521-3380-4cc8-a7ef-2f835786c249
		summarizeBy: none
		isNameInferred
		sourceColumn: [Description]

		annotation SummarizationSetBy = Automatic

	partition 'Glossary New' = calculated
		mode: import
		source =
				VAR ColumnsTable =
				    SELECTCOLUMNS(
				        FILTER(INFO.VIEW.COLUMNS(), [Description] <> BLANK()),
				        "Name", [Name],
				        "Table", [Table],
				        "Description", [Description]
				    )
				VAR MeasuresTable =
				    SELECTCOLUMNS(
				        INFO.VIEW.MEASURES(),
				        "Name", [Name],
				        "Table", [Table],
				        "Description", [Description]
				    )
				RETURN
				    UNION(ColumnsTable, MeasuresTable)

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

