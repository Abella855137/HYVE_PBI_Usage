table 'PBI Spy User Access'
	lineageTag: 801fe44b-b17b-4885-8627-fdc29a7abfa0

	/// Count of SPY users that do not have matching RLS access.
	measure '~Flag SPY Users' = CALCULATE(DISTINCTCOUNT('PBI Spy User Access'[user_name]),'PBI Spy User Access'[~Has RLS] = "N")
		formatString: 0
		lineageTag: 24c26bf5-8a22-4870-9135-02ac8012c244

	/// Share of SPY users missing RLS access relative to the full SPY population.
	measure '~Flag SPY Users Ratio' = DIVIDE([~Flag SPY Users], COUNT('PBI Spy User Access'[user_name]))
		lineageTag: de98fecd-3ed7-41cf-99ca-8835e8e934b6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

