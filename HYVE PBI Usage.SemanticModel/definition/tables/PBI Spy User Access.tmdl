	/// Flag showing whether each SPY user has a matching RLS permission for the same report key.
	column '~Has RLS' = ```
			
			IF(
			    CONTAINS(
			        FILTER('RLS Combine New', 'RLS Combine New'[#Report Name Key] = 'PBI Spy User Access'[#Report Name Key]),
			        'RLS Combine New'[#GID],
			        'PBI Spy User Access'[global_employee_id]
			    ),
			    "Y", 
			    "N"
			)
			```
		lineageTag: 49331d47-6684-47ff-8fe8-c35a39034787
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Employee UPN resolved from the matching employee global ID.
	column 'SPY UPN' = LOOKUPVALUE('Employee Info'[userPrincipalName], 'Employee Info'[Employee Global ID], 'PBI Spy User Access'[global_employee_id])
		lineageTag: 4646dc38-bdf7-4934-9d0f-95a894b005ea
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Combined workspace and normalized report name used as a join key.
	column '#Report Name Key' = 'PBI Spy User Access'[workspace_name] &"-"& 'PBI Spy User Access'[#Report Name Revise]
		lineageTag: 255d13a5-6e75-4eb5-b0d4-da2a05de9024
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Unique SPY key combining the report key and employee ID.
	column #Key1 = 'PBI Spy User Access'[#Report Name Key] &"-"& 'PBI Spy User Access'[global_employee_id]
		lineageTag: 22968e84-d499-43bb-9d28-e7d025e67e6a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Normalized report name used to align legacy and revised report naming.
	column '#Report Name Revise' = IF('PBI Spy User Access'[report_name] = "Hyve Global B Report (bigdata-AzureBlob)", "Hyve Global MPL Usage Analysis", 'PBI Spy User Access'[report_name])
		lineageTag: 129df7fa-1635-4eaf-bbd2-dee5fffa3ee9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'PBI Spy User Access' = m
		mode: import
		source =
				let
				    Source = PowerPlatform.Dataflows(null),
				    Workspaces = Source{[Id="Workspaces"]}[Data],
				    #"4529f1ba-46ff-4c8b-9e0b-600287b1340b" = Workspaces{[workspaceId="4529f1ba-46ff-4c8b-9e0b-600287b1340b"]}[Data],
				    #"0e7a08b2-fa24-4fc4-be60-86f57d5fcaf6" = #"4529f1ba-46ff-4c8b-9e0b-600287b1340b"{[dataflowId="0e7a08b2-fa24-4fc4-be60-86f57d5fcaf6"]}[Data],
				    #"PBI Spy User Access_" = #"0e7a08b2-fa24-4fc4-be60-86f57d5fcaf6"{[entity="PBI Spy User Access",version=""]}[Data],
				    #"Filtered Rows" = Table.SelectRows(#"PBI Spy User Access_", each ([workspace_name] = "Hyve Accounting" or [workspace_name] = "Hyve Corp" or [workspace_name] = "Hyve Finance" or [workspace_name] = "Hyve Manufacturing" or [workspace_name] = "Hyve Purchasing"))
				in
				    #"Filtered Rows"

